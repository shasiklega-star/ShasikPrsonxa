function toggleSuperAim()
    states.superAim = not states.superAim
    playClick()
    if states.superAim then
        if connections.superAim then connections.superAim:Disconnect() end
        connections.superAim = game:GetService("RunService").RenderStepped:Connect(function()
            if not states.superAim then return end
            local target = getClosestHead()
            if target then
                camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
            end
        end)
        if connections.silentAim then connections.silentAim:Disconnect() end
        connections.silentAim = game:GetService("RunService").RenderStepped:Connect(function()
            if not states.superAim then return end
            local target = getClosestHead()
            if target then
                local oldCF = camera.CFrame
                camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
                camera.CFrame = oldCF
            end
        end)
        if connections.triggerBot then connections.triggerBot:Disconnect() end
        connections.triggerBot = game:GetService("RunService").RenderStepped:Connect(function()
            if not states.superAim then return end
            local target = getClosestHead()
            if target then
                local origin = camera.CFrame.Position
                local direction = (target.Position - origin).Unit * 100
                local ray = Ray.new(origin, direction)
                local hit = workspace:FindPartOnRay(ray, char)
                if hit and hit:IsDescendantOf(target.Parent) then
                    pcall(function()
                        local m = game:GetService("UserInputService")
                        m:SendInputEvent(1, Enum.UserInputState.Begin, false, false)
                        task.wait(0.05)
                        m:SendInputEvent(1, Enum.UserInputState.End, false, false)
                    end)
                end
            end
        end)
        if connections.wallbang then connections.wallbang:Disconnect() end
        connections.wallbang = game:GetService("RunService").RenderStepped:Connect(function()
            if not states.superAim then return end
            local target = getClosestHead()
            if target then
                local origin = camera.CFrame.Position
                local direction = (target.Position - origin).Unit * 200
                local ray = Ray.new(origin, direction)
                local hit, hitPos = workspace:FindPartOnRay(ray, char)
                if hit and hit.Material ~= Enum.Material.Air then
                    local distance = (origin - target.Position).Magnitude
                    if distance < 50 then
                        local ray2 = Ray.new(hitPos, (target.Position - hitPos).Unit * 10)
                        local hit2 = workspace:FindPartOnRay(ray2, char)
                        if not hit2 or hit2.Material == Enum.Material.Air then
                            camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
                            pcall(function()
                                local m = game:GetService("UserInputService")
                                m:SendInputEvent(1, Enum.UserInputState.Begin, false, false)
                                task.wait(0.05)
                                m:SendInputEvent(1, Enum.UserInputState.End, false, false)
                            end)
                        end
                    end
                end
            end
        end)
        if superAimBtn then
            superAimBtn.Text = "⚡ Супер-Аим    [⊂❍]"
            superAimBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
            superAimBtn.BorderColor3 = Color3.fromRGB(255, 0, 0)
        end
        notify("Супер-Аим", true)
    else
        if connections.superAim then connections.superAim:Disconnect(); connections.superAim = nil end
        if connections.silentAim then connections.silentAim:Disconnect(); connections.silentAim = nil end
        if connections.triggerBot then connections.triggerBot:Disconnect(); connections.triggerBot = nil end
        if connections.wallbang then connections.wallbang:Disconnect(); connections.wallbang = nil end
        if superAimBtn then
            superAimBtn.Text = "⚡ Супер-Аим    [❍⊃]"
            superAimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            superAimBtn.BorderColor3 = Color3.fromRGB(100, 100, 200)
        end
        notify("Супер-Аим", false)
    end
end

