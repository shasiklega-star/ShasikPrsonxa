function removeESP(target)
    if espObjects[target] then
        local obj = espObjects[target]
        if obj.box then obj.box:Destroy() end
        if obj.nameTag then obj.nameTag:Destroy() end
        espObjects[target] = nil
    end
end

function updateESP()
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= player then
            if states.esp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if not espObjects[p] then
                    createESP(p)
                else
                    local obj = espObjects[p]
                    local tChar = p.Character
                    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                    local tHum = tChar:FindFirstChild("Humanoid")
                    
                    if tRoot and tHum then
                        local dist = (root.Position - tRoot.Position).Magnitude
                        if obj.distLabel then
                            obj.distLabel.Text = math.floor(dist) .. " м"
                        end
                        
                        if obj.label then
                            obj.label.Visible = states.espName
                            obj.label.Text = p.Name
                        end
                        
                        if obj.distLabel then
                            obj.distLabel.Visible = states.espDistance
                        end
                        
                        if obj.box then
                            local size = settings.espSize
                            obj.box.Size = Vector3.new(size, size + 2, size - 1)
                            obj.box.Transparency = settings.espTransparency
                            obj.box.Color3 = settings.espColor
                        end
                        
                        if obj.healthText and tHum and states.espHealth then
                            local health = math.floor(tHum.Health)
                            local maxHealth = math.floor(tHum.MaxHealth)
                            local healthPercent = health / maxHealth
                            
                            obj.healthText.Text = health .. " / " .. maxHealth .. " HP"
                            obj.healthText.Visible = true
                            obj.healthText.TextColor3 = settings.healthColor
                            
                            if healthPercent > 0.6 then
                                obj.healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                            elseif healthPercent > 0.3 then
                                obj.healthFill.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                            else
                                obj.healthFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                            end
                            obj.healthFill.Size = UDim2.new(healthPercent, 0, 1, 0)
                            obj.healthBg.Visible = true
                        elseif obj.healthText then
                            obj.healthText.Visible = false
                            obj.healthBg.Visible = false
                        end
                    end
                end
            else
                removeESP(p)
            end
        end
    end
end

