uis.TouchStarted:Connect(function(input)
    if not holdJumpEnabled then return end
    if input.Position.X < camera.ViewportSize.X / 2 then
        isJumping = true
        while isJumping and holdJumpEnabled do
            if humanoid and humanoid.Parent then
                humanoid.Jump = true
                humanoid.JumpPower = settings.jumpPower or 150
            end
            task.wait(0.01)
        end
    end
end)

uis.TouchEnded:Connect(function(input)
    if not holdJumpEnabled then return end
    if input.Position.X < camera.ViewportSize.X / 2 then
        isJumping = false
    end
end)

uis.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space and holdJumpEnabled then
        isJumping = true
        while isJumping and holdJumpEnabled do
            if humanoid and humanoid.Parent then
                humanoid.Jump = true
                humanoid.JumpPower = settings.jumpPower or 150
            end
            task.wait(0.01)
        end
    end
end)

uis.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then
        isJumping = false
    end
end)

